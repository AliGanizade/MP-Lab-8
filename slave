#define F_CPU 16000000UL
#include <avr/io.h>

#define SLAVE_ADDR 0x08

volatile uint8_t state = 0x00;

void setup() {
  TWAR = (SLAVE_ADDR << 1);
  TWCR = (1 << TWEN) | (1 << TWEA) | (1 << TWINT); 

  PORTC |= (1 << PC4) | (1 << PC5);

  DDRB |= (1 << PB5); 
  DDRD &= ~(1 << PD2); 
  PORTD |= (1 << PD2);
}

void loop() {
      if (!(PIND & (1 << PD2))) { 
          state = 0x02;
      }

      if (TWCR & (1 << TWINT)) {
          uint8_t status = TWSR & 0b11111000; 

          if (status == 0x60) { 
              TWCR = (1 << TWEN) | (1 << TWEA) | (1 << TWINT);
          } else if (status == 0x80) { 
              uint8_t received = TWDR; 
              if (received == 0x01) { 
                  PORTB |= (1 << PB5);
              } else {
                  PORTB &= ~(1 << PB5);
              }
              TWCR = (1 << TWEN) | (1 << TWEA) | (1 << TWINT);
          } else if (status == 0xA8) { 
              TWDR = state; 
              TWCR = (1 << TWEN) | (1 << TWEA) | (1 << TWINT);
              state = 0x00;
          } else { 
              TWCR = (1 << TWEN) | (1 << TWEA) | (1 << TWINT);
          }
      }
}
